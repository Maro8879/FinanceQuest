    {
      "id": "l3",
      "kind": "lesson",
      "title": "Accumulating vs distributing ETF",
      "pages": [
        {
          "blocks": [
            {
              "type": "heading",
              "text": "Accumulating vs distributing ETF"
            },
            {
              "type": "image",
              "image": "obrazki/3-etf-akumulujacy-vs-dystrybuu.png",
              "width": 1,
              "maxHeight": 240,
              "caption": ""
            },
            {
              "type": "list",
              "items": [
                "**Distributing** – pays dividends into your account, e.g. every quarter",
                "**Accumulating** – reinvests dividends itself, so compounding works without you doing anything"
              ]
            },
            {
              "type": "text",
              "text": "For a long horizon, **accumulating** is usually better – in many countries you also defer tax until you sell."
            },
            {
              "type": "text",
              "text": "**Distributing** suits you when you want a regular income, e.g. in retirement."
            }
          ]
        }
      ],
      "minigame": {
        "game": "",
        "settings": []
      },
      "tasks": []
    },
