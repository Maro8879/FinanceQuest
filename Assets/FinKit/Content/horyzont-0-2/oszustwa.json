    {
      "id": "l3",
      "kind": "lesson",
      "title": "Common scams",
      "pages": [
        {
          "blocks": [
            {
              "type": "heading",
              "text": "Common scams"
            },
            {
              "type": "image",
              "image": "obrazki/3-popularne-oszustwa.png",
              "width": 1,
              "maxHeight": 240,
              "caption": ""
            },
            {
              "type": "text",
              "text": "Scammers all over the world follow a few **repeating patterns**:"
            },
            {
              "type": "list",
              "items": [
                "**Phishing and spoofing** – fake emails, text messages and calls “from the bank”",
                "**Fake platforms** – the screen shows profits that don't exist",
                "**Pyramid schemes** – old members' profits are new members' deposits",
                "**Celebrity deepfakes** – fake ads on social media"
              ]
            },
            {
              "type": "callout",
              "text": "No bank will ever ask for your **password**, a remote-access app or a transfer to a “safe account”."
            }
          ]
        }
      ],
