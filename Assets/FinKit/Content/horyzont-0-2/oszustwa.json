    {
      "id": "l4",
      "kind": "lesson",
      "title": "How to protect yourself",
      "pages": [
        {
          "blocks": [
            {
              "type": "heading",
              "text": "How to protect yourself"
            },
            {
              "type": "image",
              "image": "obrazki/4-jak-sie-chronic.png",
              "width": 1,
              "maxHeight": 240,
              "caption": ""
            },
            {
              "type": "text",
              "text": "A few rules protect you from most scams:"
            },
            {
              "type": "list",
              "items": [
                "**Check the company** in the regulator's register (KNF, BaFin) and on the warning list",
                "**Never give** anyone your passwords or SMS codes",
                "**Don't install** remote-access apps at an “adviser's” request",
                "**Invest** only through a licensed broker, into an account in your own name"
              ]
            },
            {
              "type": "callout",
              "text": "**The 24-hour rule** – no financial decision under pressure."
            }
          ]
        }
      ],
      "minigame": {
