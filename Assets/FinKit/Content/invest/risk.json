    {
      "id": "l1",
      "kind": "lesson",
      "title": "What risk is",
      "pages": [
        {
          "blocks": [
            {
              "type": "heading",
              "text": "What is risk?"
            },
            {
              "type": "text",
              "text": "Risk is the **chance** that an investment's result will be **different** from what you expect – better or worse."
            },
            {
              "type": "image",
              "image": "obrazki/wahania-2.png",
              "width": 1,
              "maxHeight": 200,
              "caption": "A share price over a year – up and down"
            },
            {
              "type": "callout",
              "text": "A higher possible profit usually means **higher risk**."
            }
          ]
        },
        {
          "blocks": [
            {
              "type": "heading",
              "text": "Different assets, different swings"
            },
            {
              "type": "list",
              "items": [
                "**Deposit** – small swings",
                "**Bonds** – medium swings",
                "**Stocks** – big swings"
              ]
            },
            {
              "type": "divider"
            },
            {
              "type": "text",
              "text": "The longer you invest, the **easier it is to ride out** drops."
            }
          ]
        }
      ],
      "tasks": [
        {
          "type": "choice",
          "prompt": "What usually goes hand in hand with a higher possible profit?",
          "multi": false,
          "options": [
            {
              "text": "Higher risk",
              "correct": true
            },
            {
              "text": "Lower risk",
              "correct": false
            },
            {
              "text": "No risk",
              "correct": false
            }
          ],
          "explain": "The bigger the possible profit, the bigger the chance that the result will differ from what you expect.",
          "fact": "Investors call this the risk premium.",
