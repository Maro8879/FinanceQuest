      "title": "Podatek od zysków",
      "pages": [
        {
          "blocks": [
            {
              "type": "heading",
              "text": "Podatek od zysków"
            },
            {
              "type": "image",
              "image": "obrazki/3-podatek-od-zyskow.png",
              "width": 1,
              "maxHeight": 240,
              "caption": ""
            },
            {
              "type": "text",
              "text": "Od zysków z inwestycji płacisz podatek: w Polsce **podatek Belki**, w Niemczech **Abgeltungsteuer**. Obejmuje m.in.:"
            },
            {
              "type": "list",
              "items": [
                "zysk ze **sprzedaży** akcji i ETF-ów",
                "**dywidendy**",
                "**odsetki** z lokat i obligacji"
              ]
            },
            {
              "type": "callout",
              "text": "Płacisz tylko od **zysku** i dopiero, gdy go zrealizujesz. Dopóki trzymasz inwestycję, cały kapitał **dalej pracuje**."
            }
          ]
        }
      ],
